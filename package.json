{
  "name": "fleetflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "superset:setup": "node superset/setup.mjs",
    "superset:up": "docker compose -f superset/compose.yml up -d --build",
    "superset:down": "docker compose -f superset/compose.yml down",
    "superset:verify": "docker compose -f superset/compose.yml exec -T superset python /app/fleetflow/verify.py",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:import:kaggle": "tsx prisma/import-kaggle.ts",
    "db:verify:kaggle": "tsx prisma/verify-kaggle.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:sync:reference": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@prisma/client": "^6.17.0",
    "@superset-ui/embedded-sdk": "^0.3.0",
    "csv-parse": "^7.0.3",
    "lucide-react": "^1.78.0",
    "maplibre-gl": "^6.19.0",
    "next": "^15.5.0",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.5.0",
    "prisma": "^6.17.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
