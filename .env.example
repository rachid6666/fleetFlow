DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fleetflow?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
# Optional compatibility name for deployments that still expect it.
NEXTAUTH_SECRET="replace-with-the-same-secret-as-AUTH_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# Authentik OIDC
# Example: https://authentik.example.com/application/o/fleetflow/
AUTHENTIK_ISSUER="https://authentik.example.com/application/o/fleetflow/"
AUTHENTIK_ID="replace-with-authentik-client-id"
AUTHENTIK_SECRET="replace-with-authentik-client-secret"
AUTHENTIK_ADMIN_GROUP="FleetFlow Admins"
AUTHENTIK_DRIVER_GROUP="FleetFlow Drivers"

# Optional Apache Superset embedded network dashboard
SUPERSET_URL="http://localhost:8088"
SUPERSET_DASHBOARD_ID="your-dashboard-uuid"
SUPERSET_USERNAME="fleetflow-embed-service"
SUPERSET_PASSWORD="replace-with-superset-service-account-password"
NEXT_PUBLIC_SUPERSET_URL="http://localhost:8088"
NEXT_PUBLIC_SUPERSET_DASHBOARD_ID="your-dashboard-uuid"
