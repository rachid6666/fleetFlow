POSTGRES_DB="fleetflow"
POSTGRES_USER="fleetflow"
POSTGRES_PASSWORD="fleetflow-local-password"
APP_PORT="3000"
POSTGRES_PORT="5432"
N8N_PORT="5678"

# Local Compose URLs use service names inside containers. Do not use these for production.
DATABASE_URL="postgresql://fleetflow:fleetflow-local-password@postgres:5432/fleetflow?schema=public"
DATABASE_URL_UNPOOLED="postgresql://fleetflow:fleetflow-local-password@postgres:5432/fleetflow?schema=public"
AUTH_SECRET="local-development-secret-change-me"
AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="local-development-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"

# n8n integration. Keep these local-only; workflow exports contain no secret values.
N8N_ENCRYPTION_KEY="local-n8n-encryption-key-change-me"
N8N_WEBHOOK_SECRET="local-n8n-webhook-secret"
FLEETFLOW_API_URL="http://app:3000"
FLEETFLOW_HANDOVER_WEBHOOK_URL="http://n8n:5678/webhook/fleetflow/shipment-handover"
TEAM_NOTIFICATION_WEBHOOK_URL=""

# Authentik OIDC
# Example: https://authentik.example.com/application/o/fleetflow/
AUTHENTIK_ISSUER="https://authentik.example.com/application/o/fleetflow/"
AUTHENTIK_ID="replace-with-authentik-client-id"
AUTHENTIK_SECRET="replace-with-authentik-client-secret"
AUTHENTIK_ADMIN_GROUP="FleetFlow Admins"
AUTHENTIK_DRIVER_GROUP="FleetFlow Drivers"

# Optional Apache Superset embedded network dashboard
SUPERSET_URL="http://localhost:8088"
SUPERSET_DASHBOARD_ID="your-dashboard-uuid"
SUPERSET_USERNAME="fleetflow-embed-service"
SUPERSET_PASSWORD="replace-with-superset-service-account-password"
NEXT_PUBLIC_SUPERSET_URL="http://localhost:8088"
NEXT_PUBLIC_SUPERSET_DASHBOARD_ID="your-dashboard-uuid"
