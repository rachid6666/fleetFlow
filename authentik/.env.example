# Separate Neon PostgreSQL database for Authentik.
# PG_HOST is the pooled endpoint with -pooler in the hostname.
PG_HOST="ep-example-pooler.us-east-2.aws.neon.tech"
# PG_DIRECT_HOST is the direct endpoint without -pooler for locks and migrations.
PG_DIRECT_HOST="ep-example.us-east-2.aws.neon.tech"
PG_PORT="5432"
PG_DB="authentik"
PG_USER="USER"
PG_PASS="PASSWORD"
PG_SSLMODE="require"

AUTHENTIK_SECRET_KEY="replace-with-a-long-random-secret"
AUTHENTIK_TAG="2026.8.5"
COMPOSE_PORT_HTTP="9000"
COMPOSE_PORT_HTTPS="9443"
