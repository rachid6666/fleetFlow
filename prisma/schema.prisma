datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  DRIVER
  CUSTOMER
}

enum ShipmentStatus {
  PENDING
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  EXCEPTION
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  password        String
  name            String
  role            Role       @default(CUSTOMER)
  shipments       Shipment[] @relation("DriverShipments")
  clientShipments Shipment[] @relation("CustomerShipments")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Branch {
  id                String     @id @default(cuid())
  code              String     @unique
  name              String
  city              String
  country           String
  region            String
  latitude          Decimal    @db.Decimal(9, 6)
  longitude         Decimal    @db.Decimal(9, 6)
  isActive          Boolean    @default(true)
  outboundShipments Shipment[] @relation("OriginBranch")
  inboundShipments  Shipment[] @relation("DestinationBranch")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([country, isActive])
}

model Shipment {
  id           String         @id @default(cuid())
  trackingCode String         @unique @default(uuid())
  origin       String
  destination  String
  originBranchId String?
  originBranch   Branch?        @relation("OriginBranch", fields: [originBranchId], references: [id])
  destinationBranchId String?
  destinationBranch   Branch?   @relation("DestinationBranch", fields: [destinationBranchId], references: [id])
  status       ShipmentStatus @default(PENDING)
  notes        String?
  driverId     String?
  driver       User?          @relation("DriverShipments", fields: [driverId], references: [id])
  customerId   String
  customer     User           @relation("CustomerShipments", fields: [customerId], references: [id])
  updates      StatusLog[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@index([driverId, status])
  @@index([customerId])
  @@index([originBranchId])
  @@index([destinationBranchId])
}

model StatusLog {
  id          String         @id @default(cuid())
  shipmentId  String
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      ShipmentStatus
  location    String?
  description String
  createdAt   DateTime       @default(now())

  @@index([shipmentId, createdAt])
}
